### Production environment template for Decide$
### Copy this file to your server as environment variables
### (or as `.env.local` if your hosting model requires file-based envs).
### Never commit real secrets.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
APP_TIMEZONE=UTC
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

### Database (same format as Symfony DATABASE_URL)
### Example for MariaDB:
### mysql://decide_user:STRONG_DB_PASSWORD@127.0.0.1:3306/decides_db?serverVersion=10.11.2-MariaDB&charset=utf8mb4
DATABASE_URL="mysql://CHANGE_DB_USER:CHANGE_DB_PASSWORD@CHANGE_DB_HOST:3306/CHANGE_DB_NAME?serverVersion=10.11.2-MariaDB&charset=utf8mb4"

### Messenger
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

### Mailer (set your SMTP provider)
MAILER_DSN=smtp://CHANGE_SMTP_USER:CHANGE_SMTP_PASSWORD@CHANGE_SMTP_HOST:587?encryption=tls&auth_mode=login
MAILER_FROM_ADDRESS=no-reply@example.com
MAILER_FROM_NAME="Decide Finance Bot"
FINANCE_ALERT_TO=alerts@example.com
ADMIN_ALERT_EMAIL=admin@example.com

### Optional OAuth / External APIs
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
FACEBOOK_OAUTH_CLIENT_ID=CHANGE_ME
FACEBOOK_OAUTH_CLIENT_SECRET=CHANGE_ME

FACEPP_API_KEY=CHANGE_ME
FACEPP_API_SECRET=CHANGE_ME
FACEPP_API_BASE_URL=https://api-us.faceplusplus.com
FACEPP_MIN_CONFIDENCE=80

GEO_API_KEY=
GEO_LOOKUP_ENDPOINT=https://ipwho.is/%s
GEO_REFRESH_HOURS=6

OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
GOOGLE_AI_API_KEY=CHANGE_ME
GOOGLE_AI_MODEL=gemini-2.5-flash
LOCATIONIQ_API_KEY=CHANGE_ME

GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

PDFSHIFT_API_KEY=CHANGE_ME
PDFSHIFT_PROCESSOR_VERSION=142

